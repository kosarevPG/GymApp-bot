SPREADSHEET_ID=your_spreadsheet_id
GOOGLE_CREDENTIALS_BASE64=base64_encoded_service_account_json
AUTH_TOKEN=choose_a_long_random_token
BOT_TOKEN=optional_telegram_bot_token
TELEGRAM_WEBHOOK_SECRET=optional_random_webhook_secret
FRONTEND_URL=https://your-user.github.io/GymApp-bot/
SUPABASE_URL=https://your-project.supabase.co
# Server-side only. Never place this key in the frontend bundle.
SUPABASE_SERVICE_ROLE_KEY=server_only_secret
# Publishable/anon API key used by the backend only as the Auth API apikey.
SUPABASE_AUTH_API_KEY=publishable_key

# Object Storage для фото упражнений (без них /api/upload_image вернёт 400)
S3_BUCKET=your_public_read_bucket
S3_ACCESS_KEY_ID=static_access_key_id
S3_SECRET_ACCESS_KEY=static_access_key_secret
# Необязательно, по умолчанию https://storage.yandexcloud.net
S3_ENDPOINT=https://storage.yandexcloud.net
